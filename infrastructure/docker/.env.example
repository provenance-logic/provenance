# Provenance Docker Compose environment — copy to .env and fill in values.
# Never commit .env to version control.

# PostgreSQL (shared instance — used by provenance API, Keycloak, and Kong)
POSTGRES_PASSWORD=provenance_dev_password

# Neo4j
NEO4J_PASSWORD=provenance_dev_password

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=provenance
MINIO_ROOT_PASSWORD=provenance_dev_password

# Keycloak admin credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=provenance_dev_admin

# Keycloak client secrets (generated after Keycloak is configured)
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_AGENT_CLIENT_SECRET=

# MCP API key (authenticates requests between API and agent-query)
# Generate with: openssl rand -hex 32
# Rotate every 90 days. Never reuse a key from git history.
MCP_API_KEY=

# Default organization ID (used by agent-query when no org context is provided)
DEFAULT_ORG_ID=

# Anthropic API key (used by agent-query for NL query translation)
# Required for Phase 4 agent features. Leave empty for Phase 1.
ANTHROPIC_API_KEY=

# Port connection-details encryption (Domain 10 Workstream B — F10.6).
# One of the two must be set or the API will refuse to boot.
#
# Production: set CONNECTION_DETAILS_SECRET_ARN to an AWS Secrets Manager
# ARN holding a 32-byte AES key (hex-encoded). The API reads the secret
# at first use and caches it in memory.
#
# Dev / demo: set CONNECTION_DETAILS_DEV_KEY to a 64-char hex string. The
# default below is a throwaway key for local dev only — any connection
# details encrypted with it are effectively unprotected. Never use this
# value outside a disposable dev environment.
# Generate a fresh key with: openssl rand -hex 32
CONNECTION_DETAILS_SECRET_ARN=
CONNECTION_DETAILS_DEV_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# ----- Seed API (Phase 5.6 — dev experience) ----------------------------------
# Mounts the /api/v1/seed/* controller used by the @provenance/seed package's
# runner to populate orgs, domains, principals, policies, products, agents,
# and lineage in a fresh stack. Endpoints require an x-seed-service-token
# header that is constant-time-compared to SEED_API_KEY.
#
# Production must NEVER set SEED_ENABLED=true. The seed surface bypasses
# JWT auth and trusts the caller's claimed identity for the seed payload.
SEED_ENABLED=true
SEED_API_KEY=dev-seed-token-change-me

# ----- Agent Query Layer ↔ API internal endpoint token (Domain 12) ------------
# The Agent Query Layer calls /api/v1/internal/consent/connection-references/*
# for connection-reference cache cold-load and cache-miss fallback per ADR-006.
# Constant-time-compared by InternalServiceGuard against the
# x-internal-service-token header. Minimum 16 characters.
#
# Generate a strong value with: openssl rand -hex 32
# Both the api service and the agent-query service must hold the same value.
# - api side: InternalServiceGuard constant-time-compares against this.
# - agent-query side: InternalControlPlaneClient sends this as the
#   x-internal-service-token header on calls to /api/v1/internal/consent/*
#   for connection-reference cache cold-load and cache-miss fallback.
AQL_INTERNAL_TOKEN=dev-aql-internal-token-change-me

# ----- Connection-reference runtime enforcement (Domain 12) ------------------
# When `true` (default), the connection-reference guard ENFORCES: agents that
# lack an active access grant + active connection reference + matching scope
# get denied with the distinct deny code in an MCP isError result.
# When `false`, the guard runs in SHADOW MODE — audits would-be denials and
# logs the decision but does not block. Useful for soak-testing on existing
# installations before committing to the flip.
#
# Upgrade note for installations that ran prior versions in shadow mode:
# run POST /api/v1/internal/consent/legacy-agent-migration before deploying
# this version (idempotent). Without it, existing agents lose access on the
# next request after deploy.
CONNECTION_REFERENCE_ENFORCEMENT_ENABLED=true

# ----- Seed CLI shell vars (used by `pnpm --filter @provenance/seed seed`) ----
# The seed CLI runs from the host and connects to postgres + Keycloak directly.
# DATABASE_URL points at the local postgres exposed by docker-compose on
# :5432 with the default credentials. KEYCLOAK_ADMIN_CLIENT_SECRET matches
# the `provenance-admin` confidential client secret baked into the realm
# JSON (infrastructure/docker/config/keycloak/realms/provenance-realm.json).
# Both are throwaway dev values — never use them outside a disposable env.
DATABASE_URL=postgres://provenance:provenance_dev_password@localhost:5432/provenance
KEYCLOAK_ADMIN_CLIENT_SECRET=provenance-admin-dev-secret

# Shared token between the seed CLI and the API's /seed/* controllers. The API
# only mounts those controllers when SEED_ENABLED=true, and authenticates the
# x-seed-service-token header against this value with a constant-time compare.
# Throwaway dev value below — never reuse outside a disposable env. To enable
# the demo-sync seed step, also set SEED_ENABLED=true on the API side.
SEED_API_KEY=seed-dev-service-token
SEED_ENABLED=true

# ----- Temporal --------------------------------------------------------------
# Temporal hosts the access-approval workflow (SLA timer + escalation) and the
# Domain 12 connection-reference timers (automatic expiration, MAJOR-version
# suspension). The default ec2-dev compose runs a temporal container on the
# stack network; set TEMPORAL_ENABLED=false in stacks where you have not
# brought up a temporal server (the lightweight docker-compose.dev.yml does
# this). When false, access requests still create rows but no SLA timer fires.
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# ----- Caddy public hostnames (ec2-dev compose only) -------------------------
# The containerized Caddy in docker-compose.ec2-dev.yml provisions Let's Encrypt
# certificates for these two hostnames and reverse-proxies to api/web/agent-query
# /keycloak. The Caddyfile uses `{$PRIMARY_DOMAIN:dev.provenancelogic.com}` /
# `{$AUTH_DOMAIN:auth.provenancelogic.com}` syntax so the defaults work for the
# long-running dev environment without setting anything. The demo bootstrap
# script overrides them per demo cycle to point at the demo hostnames.
PRIMARY_DOMAIN=dev.provenancelogic.com
AUTH_DOMAIN=auth.provenancelogic.com
