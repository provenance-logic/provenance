{
  "id": "provenance",
  "realm": "provenance",
  "displayName": "Provenance",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "noreply@provenancelogic.com",
    "fromDisplayName": "Provenance",
    "replyTo": "noreply@provenancelogic.com",
    "replyToDisplayName": "Provenance",
    "envelopeFrom": "noreply@provenancelogic.com",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "org_admin",
        "description": "Organization administrator — full control over org settings, domains, and members",
        "composite": false
      },
      {
        "name": "domain_owner",
        "description": "Domain owner — manages a domain and its data products",
        "composite": false
      },
      {
        "name": "data_product_owner",
        "description": "Data product owner — authors and publishes data products within a domain",
        "composite": false
      },
      {
        "name": "consumer",
        "description": "Data consumer — discovers and requests access to data products",
        "composite": false
      },
      {
        "name": "governance_member",
        "description": "Governance team member — authors policies and reviews compliance",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "provenance-web",
      "name": "Provenance Web",
      "description": "React frontend — public PKCE client",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://54.83.160.49:3000/*",
        "https://dev.provenancelogic.com/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://54.83.160.49:3000",
        "https://dev.provenancelogic.com"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "provenance_principal_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "provenance_principal_id",
            "claim.name": "provenance_principal_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "provenance_org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "provenance_org_id",
            "claim.name": "provenance_org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "provenance_principal_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "provenance_principal_type",
            "claim.name": "provenance_principal_type",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provenance-api",
      "name": "Provenance API",
      "description": "NestJS control plane — bearer-only resource server",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "provenance-admin",
      "name": "Provenance Admin",
      "description": "Confidential service account used by the NestJS API for Keycloak management operations — creating users on invite acceptance, provisioning agent clients (ADR-002), triggering email verification flows.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "provenance-admin-dev-secret"
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "test@provenance.dev",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "provenance_dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "org_admin"
      ]
    },
    {
      "username": "service-account-provenance-admin",
      "enabled": true,
      "serviceAccountClientId": "provenance-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "manage-clients",
          "query-clients",
          "view-users",
          "view-realm"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  }
}
